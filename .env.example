# Django Settings
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-replace-with-secure-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# Database Settings (PostgreSQL)
DB_NAME=securecart_db
DB_USER=postgres
DB_PASSWORD=postgres_secure_password
DB_HOST=db
DB_PORT=5432

USE_SQLITE=True

# AES-256-GCM Encryption Key
# The key MUST be exactly 32 bytes (256 bits), represented as a 64-character hex string.
# To generate a new random key, run in your terminal:
# python -c "import secrets; print(secrets.token_hex(32))"
#
# DO NOT COMMIT YOUR PRODUCTION KEY TO VERSION CONTROL.
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
